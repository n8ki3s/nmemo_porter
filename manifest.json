{
  "manifest_version": 3,
  "name": "nmemo porter - 네이버 메모 백업·가져오기",
  "version": "1.1.1",
  "description": "네이버 메모와 네이버 블로그 글을 마크다운 파일로 저장하고, 메모 백업을 다시 가져옵니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://memo.naver.com/*",
    "https://blog.naver.com/*",
    "https://m.blog.naver.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "nmemo porter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://memo.naver.com/*"
      ],
      "js": [
        "memo-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://memo.naver.com/*",
        "https://blog.naver.com/*",
        "https://m.blog.naver.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
